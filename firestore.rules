rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for authentication and roles
    function isSignedIn() {
      return request.auth != null;
    }

    // College user verification: Google Auth with college domain (e.g., college.edu)
    function isCollegeUser() {
      return isSignedIn() && (
        request.auth.token.email.matches('.*@college[.]edu$') ||
        request.auth.token.email_verified == true
      );
    }

    // Role check: verifies either custom claims or user profile document in Firestore
    function isManagement() {
      return isCollegeUser() && (
        request.auth.token.role == 'management' ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'management'
        )
      );
    }

    // Collection: issues
    match /issues/{issueId} {

      // 1. Any signed-in college user can read all issues
      allow read: if isCollegeUser();

      // 2. Any signed-in college user can report/create an issue
      // - Must set reportedBy to their own authenticated UID
      // - Initial status must be 'reported'
      allow create: if isCollegeUser() &&
        request.resource.data.reportedBy == request.auth.uid &&
        request.resource.data.status == 'reported' &&
        request.resource.data.title is string &&
        request.resource.data.title.size() > 0 &&
        request.resource.data.meTooBy.size() == 0;

      // 3. Issue updates:
      allow update: if isCollegeUser() && (
        // Case A: Reporter can edit ONLY their own issue's description
        isReporterDescriptionEdit() ||

        // Case B: Only management can change status, assignedTo, afterPhotoUrl (and resolvedAt)
        isManagementStatusOrAssignmentEdit() ||

        // Case C: Anyone can add or remove ONLY their own UID in meTooBy
        isMeTooToggle()
      );

      // Helper for Case A: Reporter edits only description
      function isReporterDescriptionEdit() {
        let isReporter = request.auth.uid == resource.data.reportedBy;
        let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
        
        return isReporter &&
          changedKeys.hasOnly(['description', 'updatedAt']) &&
          request.resource.data.description is string &&
          request.resource.data.description.size() > 0;
      }

      // Helper for Case B: Management changes status, assignedTo, afterPhotoUrl
      function isManagementStatusOrAssignmentEdit() {
        let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
        
        return isManagement() &&
          changedKeys.hasAny(['status', 'assignedTo', 'afterPhotoUrl']) &&
          changedKeys.hasOnly(['status', 'assignedTo', 'afterPhotoUrl', 'resolvedAt', 'updatedAt']) &&
          request.resource.data.status in ['reported', 'in_progress', 'resolved'];
      }

      // Helper for Case C: Anyone adds or removes their own UID in meTooBy
      function isMeTooToggle() {
        let changedKeys = request.resource.data.diff(resource.data).affectedKeys();
        let targetSet = request.resource.data.meTooBy.toSet();
        let sourceSet = resource.data.meTooBy.toSet();

        let addedUids = targetSet.difference(sourceSet);
        let removedUids = sourceSet.difference(targetSet);

        // User can only add their own UID, or remove their own UID
        let isAddingSelfOnly = addedUids == [request.auth.uid].toSet() && removedUids.size() == 0;
        let isRemovingSelfOnly = removedUids == [request.auth.uid].toSet() && addedUids.size() == 0;

        return (isAddingSelfOnly || isRemovingSelfOnly) &&
          changedKeys.hasOnly(['meTooBy', 'updatedAt']);
      }

      // 4. Deletion: Only management is permitted to delete issue records
      allow delete: if isManagement();
    }

    // User profiles collection (stores user roles: student, staff, management)
    match /users/{userId} {
      allow read: if isCollegeUser();
      allow create: if isCollegeUser() && request.auth.uid == userId;
      // Users can update their own profile, but cannot elevate their own role to 'management'
      allow update: if isCollegeUser() && (
        isManagement() ||
        (
          request.auth.uid == userId &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role'])
        )
      );
      allow delete: if isManagement();

      // Notifications subcollection: users/{userId}/notifications/{notificationId}
      match /notifications/{notificationId} {
        // Users can read and mark their own notifications as read
        allow read, update: if isCollegeUser() && request.auth.uid == userId;
        // Created and managed by backend Cloud Functions (or management)
        allow create, delete: if isManagement() || request.auth.uid == userId;
      }
    }
  }
}
